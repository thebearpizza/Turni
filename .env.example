NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@turni.app

# URL pubblico dell'app (usato nelle email e nei link di approvazione)
NEXT_PUBLIC_APP_URL=https://your-vercel-deployment.vercel.app

# Email notifications (Resend — https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=flavianoconiglio94@gmail.com

# Google Generative AI (Gemini) — assistente Telegram, controllo duplicati
# spese Cassa, matching articoli fatture. Senza questa chiave le
# funzionalità AI si disattivano in automatico (fallback a comportamento
# non-AI).
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Estrazione OCR fatture — coppia separata, così da poterla alzare
# indipendentemente dal resto. gemini-2.5-pro sarebbe più accurato sui
# nomi articolo, ma richiede un piano Gemini con quota su Pro: senza,
# risponde RESOURCE_EXHAUSTED e si perdono solo secondi prima di
# ripiegare comunque su Flash.
GEMINI_MODEL_ESTRAZIONE=gemini-2.5-flash
GEMINI_FALLBACK_MODEL_ESTRAZIONE=gemini-2.5-flash-lite

# ── Prenotazioni: lettura della casella dei libri visite ─────────────
# La tab Prenotazioni (solo manager) aggrega TheFork e Restoo leggendo
# ogni pochi minuti le mail di notifica che i due gestionali mandano
# alla casella del ristorante. Senza queste variabili la tab funziona
# comunque, ma solo con inserimento manuale e import da file.
#
# Come ottenerle (una volta sola, dall'account proprietario della
# casella — es. portorotondo@ilfarogestioni.com):
#  1. console.cloud.google.com → nuovo progetto → abilita "Gmail API"
#  2. Schermata consenso OAuth → tipo "Esterno" → PUBBLICALA IN
#     PRODUZIONE (in modalità "Test" Google invalida il refresh token
#     dopo 7 giorni e la sincronizzazione si ferma da sola)
#  3. Credenziali → ID client OAuth → tipo "App desktop"
#  4. Genera un refresh token con scope
#     https://www.googleapis.com/auth/gmail.readonly
#     (sola lettura: l'app non può inviare né cancellare nulla)
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# Segreto condiviso con lo scheduler che chiama
# GET /api/cassa/prenotazioni/sync. La pianificazione vive su pg_cron in
# Supabase (stesso meccanismo dei reminder e di close_stale_shifts), non
# su Vercel: il job passa questo valore come header
# "Authorization: Bearer ...".
CRON_SECRET=your-cron-shared-secret
